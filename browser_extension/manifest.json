{
  "manifest_version": 3,
  "name": "DGM-MAT Browser Mission Operator",
  "version": "0.3.1",
  "description": "Visible authenticated AI session recovery and approved mission execution across ChatGPT, Grok, Gemini, DeepSeek and Qwen.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8181/*",
    "http://localhost:8181/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://bard.google.com/*",
    "https://grok.com/*",
    "https://x.com/i/grok*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DGM-MAT Recovery"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://bard.google.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
